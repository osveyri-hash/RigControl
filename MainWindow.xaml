<Window x:Class="RigControl.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Rig Control"
        Width="1180" Height="800" MinWidth="1020" MinHeight="680"
        Background="{DynamicResource WindowGradient}" Foreground="{DynamicResource TextBrush}"
        FontFamily="{StaticResource KawaiiFont}" FontSize="13" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Display" TextOptions.TextRenderingMode="ClearType"
        WindowStartupLocation="CenterScreen"
        AllowDrop="True" Drop="OnDropFile" DragOver="OnDragOver"
        PreviewKeyDown="OnWindowPreviewKeyDown">
    <!-- Свой заголовок окна: кнопки свернуть, развернуть и закрыть рисуем сами -->
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="34" ResizeBorderThickness="6" GlassFrameThickness="0,0,0,1"
                      CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>

    <Grid x:Name="RootGrid">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="236" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <!-- ═══════════════ Боковое меню ═══════════════ -->
        <Border Grid.Column="0" Background="{DynamicResource SidebarGradient}"
                BorderBrush="{DynamicResource LineBrush}" BorderThickness="0,0,1,0">
            <DockPanel Margin="16,22,16,14" LastChildFill="True">
                <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="4,0,0,18">
                    <Border Width="44" Height="44" CornerRadius="10">
                        <Border.Background>
                            <ImageBrush ImageSource="Assets/Logo.png" Stretch="UniformToFill"
                                        RenderOptions.BitmapScalingMode="NearestNeighbor" />
                        </Border.Background>
                    </Border>
                    <StackPanel Margin="10,0,0,0" VerticalAlignment="Center">
                        <TextBlock Text="Rig Control" FontSize="18" FontWeight="SemiBold" />
                        <TextBlock Text="Панель устройств" FontSize="11" Margin="0,3,0,0" Foreground="{DynamicResource MutedBrush}" />
                    </StackPanel>
                </StackPanel>

                <!-- Профили одной кнопкой -->
                <StackPanel DockPanel.Dock="Top" Margin="0,0,0,14">
                    <TextBlock Text="ПРОФИЛЬ" Style="{StaticResource NavCaption}" Margin="6,0,0,7" />
                    <UniformGrid x:Name="SideProfiles" Columns="3" />
                </StackPanel>

                <!-- Состояние устройств: одна компактная карточка -->
                <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
                    <Border Style="{StaticResource Card}" Padding="12,10,12,2">
                        <StackPanel>
                            <Grid Margin="0,0,0,8" Background="Transparent" Cursor="Hand" Tag="NavPump" MouseLeftButtonUp="OnStatusRowClick" ToolTip="Открыть настройки помпы">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="PumpStatusDot" Width="8" Height="8" Fill="{DynamicResource BadBrush}"
                                         VerticalAlignment="Top" Margin="0,5,9,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Помпа" FontWeight="SemiBold" />
                                    <TextBlock x:Name="PumpStatusText" Text="Не найдена" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8" Background="Transparent" Cursor="Hand" Tag="NavKeyboard" MouseLeftButtonUp="OnStatusRowClick" ToolTip="Открыть настройки клавиатуры">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="StatusDot" Width="8" Height="8" Fill="{DynamicResource BadBrush}"
                                         VerticalAlignment="Top" Margin="0,5,9,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Клавиатура" FontWeight="SemiBold" />
                                    <TextBlock x:Name="StatusText" Text="Поиск…" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel x:Name="BatteryPanel" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                            Margin="6,2,0,0" Visibility="Collapsed"
                                            ToolTip="Заряд клавиатуры (по радио, обновляется раз в 15 секунд)">
                                    <Border Width="24" Height="12" CornerRadius="3" BorderThickness="1.5" Padding="1.5"
                                            BorderBrush="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                        <Border x:Name="BatteryFill" HorizontalAlignment="Left" Width="10" CornerRadius="1.5"
                                                Background="{DynamicResource GoodBrush}" />
                                    </Border>
                                    <Border Width="2" Height="5" Background="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                            CornerRadius="0,1,1,0" />
                                    <TextBlock x:Name="BatteryText" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold" VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,0,0,8" Background="Transparent" Cursor="Hand" Tag="NavMouse" MouseLeftButtonUp="OnStatusRowClick" ToolTip="Открыть настройки мыши">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Ellipse x:Name="MouseSideDot" Width="8" Height="8" Fill="{DynamicResource BadBrush}"
                                         VerticalAlignment="Top" Margin="0,5,9,0" />
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Мышь" FontWeight="SemiBold" />
                                    <TextBlock x:Name="MouseSideText" Text="Поиск…" FontSize="11.5" Margin="0,1,0,0"
                                               Foreground="{DynamicResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                </StackPanel>
                                <StackPanel x:Name="MouseSideBattery" Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Top"
                                            Margin="6,2,0,0" Visibility="Collapsed" ToolTip="Заряд мыши">
                                    <Border Width="24" Height="12" CornerRadius="3" BorderThickness="1.5" Padding="1.5"
                                            BorderBrush="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                        <Border x:Name="MouseSideFill" HorizontalAlignment="Left" Width="10" CornerRadius="1.5"
                                                Background="{DynamicResource GoodBrush}" />
                                    </Border>
                                    <Border Width="2" Height="5" Background="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                            CornerRadius="0,1,1,0" />
                                    <TextBlock x:Name="MouseSidePercent" Margin="6,0,0,0" FontSize="11.5" FontWeight="SemiBold"
                                               VerticalAlignment="Center" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>
                    <TextBlock x:Name="MemoryText" Style="{StaticResource Cap}" FontSize="11.5" Margin="4,8,0,0"
                               ToolTip="Сколько оперативной памяти занимает программа (как «Память» в диспетчере задач). Когда окно свёрнуто или в трее, лишнее отдаётся системе." />
                </StackPanel>

                <Grid x:Name="NavHost" ClipToBounds="True"
                      SizeChanged="OnNavHostSizeChanged"
                      PreviewMouseLeftButtonDown="OnNavPreviewMouseLeftButtonDown"
                      PreviewMouseMove="OnNavPreviewMouseMove"
                      PreviewMouseLeftButtonUp="OnNavPreviewMouseLeftButtonUp"
                      LostMouseCapture="OnNavLostMouseCapture">
                    <!-- Общая стеклянная капсула плавно переезжает между пунктами меню. -->
                    <Canvas IsHitTestVisible="False" Panel.ZIndex="0">
                        <Border x:Name="NavGlassHighlight" Width="1" Height="1" Visibility="Collapsed"
                                CornerRadius="10" Background="{DynamicResource LiquidGlassBrush}"
                                BorderBrush="{DynamicResource LiquidGlassBorderBrush}" BorderThickness="1"
                                Effect="{DynamicResource LiquidGlassShadow}" />
                    </Canvas>
                    <ScrollViewer x:Name="NavScrollViewer" Panel.ZIndex="1"
                                  VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  ScrollChanged="OnNavScrollChanged">
                        <StackPanel>
                        <RadioButton x:Name="NavDevices" Style="{StaticResource NavButton}" GroupName="Nav"
                                     IsChecked="True" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE80F;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Устройства" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="УСТРОЙСТВА" Style="{StaticResource NavCaption}" Margin="6,14,0,6" />
                        <RadioButton x:Name="NavKeyboard" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE765;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Клавиатура" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavMouse" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE962;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Мышь" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavPump" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE7F4;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Помпа" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavArgb" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE706;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Подсветка" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavFans" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE9CA;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Вентиляторы" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <TextBlock Text="СИСТЕМА" Style="{StaticResource NavCaption}" Margin="6,14,0,6" />
                        <RadioButton x:Name="NavSystem" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE770;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="О системе" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        <RadioButton x:Name="NavSettings" Style="{StaticResource NavButton}" GroupName="Nav" Checked="OnNavChecked">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="&#xE713;" FontFamily="Segoe MDL2 Assets" FontSize="16" Width="26" />
                                <TextBlock Text="Настройки" FontSize="14" FontWeight="SemiBold" />
                            </StackPanel>
                        </RadioButton>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </DockPanel>
        </Border>

        <!-- ═══════════════ Страницы ═══════════════ -->
        <Grid Grid.Column="1">
            <Grid.RowDefinitions>
                <RowDefinition Height="34" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Заголовок окна: свернуть · развернуть · закрыть -->
            <StackPanel Grid.Row="0" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Top">
                <Button Style="{StaticResource CaptionButton}" Content="&#xE921;" ToolTip="Свернуть" Click="OnMinimizeClick" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Content="&#xE922;" ToolTip="Развернуть"
                        Click="OnMaximizeClick" />
                <Button Style="{StaticResource CloseCaptionButton}" Content="&#xE8BB;" ToolTip="Закрыть" Click="OnCloseClick" />
            </StackPanel>

            <!-- ───────── Устройства (главная: выбрать, что настроить) ───────── -->
            <Grid x:Name="PageDevices" Grid.Row="1" Margin="28,0,28,20">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel>
                        <TextBlock Text="Устройства" Style="{StaticResource H1}" />
                        <TextBlock x:Name="DevicesSummary" Style="{StaticResource Cap}" Margin="0,4,0,20"
                                   Text="Все устройства и их настройки — в одном месте." />
                        <WrapPanel x:Name="DeviceTiles" />

                        <!-- Профили одной кнопкой -->
                        <Grid Margin="0,22,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Профили" Style="{StaticResource H2}" />
                                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Набор настроек подсветки, вентиляторов, экрана помпы и мыши — переключается одной кнопкой здесь, в боковой панели или в меню значка в трее." />
                            </StackPanel>
                        </Grid>
                        <WrapPanel x:Name="ProfileCards" Margin="0,10,0,0" />
                        <TextBlock x:Name="ProfileNote" Style="{StaticResource Cap}" Margin="2,6,0,0" TextWrapping="Wrap"
                                   Visibility="Collapsed" />

                        <Border x:Name="ProfileEditor" Style="{StaticResource Card}" Margin="0,12,8,0" Padding="20,16,20,18"
                                MaxWidth="900" HorizontalAlignment="Left">
                            <StackPanel>
                                <TextBlock x:Name="ProfileEditorTitle" FontSize="15" FontWeight="SemiBold" />
                                <Grid Margin="0,14,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="260" />
                                        <ColumnDefinition Width="24" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel>
                                        <TextBlock Text="Название" Style="{StaticResource Cap}" Margin="0,0,0,6" />
                                        <TextBox x:Name="ProfileNameBox" MaxLength="24" KeyDown="OnProfileNameKey"
                                                 LostFocus="OnProfileNameLostFocus" />
                                        <TextBlock Text="Значок" Style="{StaticResource Cap}" Margin="0,14,0,6" />
                                        <WrapPanel x:Name="ProfileGlyphs" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="2">
                                        <TextBlock Text="Что переключает" Style="{StaticResource Cap}" Margin="0,0,0,6" />
                                        <WrapPanel>
                                            <CheckBox x:Name="ProfUseKeyboard" Content="Подсветка клавиатуры" Margin="0,0,18,8" Click="OnProfilePartClick" />
                                            <CheckBox x:Name="ProfUseArgb" Content="Подсветка СЖО" Margin="0,0,18,8" Click="OnProfilePartClick" />
                                            <CheckBox x:Name="ProfUseFans" Content="Вентиляторы" Margin="0,0,18,8" Click="OnProfilePartClick" />
                                            <CheckBox x:Name="ProfUsePump" Content="Экран помпы" Margin="0,0,18,8" Click="OnProfilePartClick" />
                                            <CheckBox x:Name="ProfUseMouse" Content="Профиль мыши" Margin="0,0,18,8" Click="OnProfilePartClick" />
                                        </WrapPanel>
                                        <TextBlock x:Name="ProfileDetails" Style="{StaticResource Cap}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                    </StackPanel>
                                </Grid>
                                <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                    <Button Content="Применить" Style="{StaticResource AccentButton}" Click="OnProfileApply" MinWidth="120" />
                                    <Button Content="Записать текущие настройки" Margin="10,0,0,0" Click="OnProfileSave"
                                            ToolTip="Запомнить в этом профиле то, что сейчас настроено на страницах устройств" />
                                    <Button x:Name="ProfileDeleteButton" Content="Удалить" Margin="10,0,0,0" Click="OnProfileDelete" />
                                </StackPanel>
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── Мышь MCHOSE: кнопки · DPI · производительность · прочее (как в M HUB) ───────── -->
            <Grid x:Name="PageMouse" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <Grid.Resources>
                    <PathGeometry x:Key="MouseBodyGeo"
                                  Figures="M 110,4 C 150,4 182,22 196,62 C 208,96 212,140 214,190 C 216,250 208,300 186,330 C 166,354 140,362 110,362 C 80,362 54,354 34,330 C 12,300 4,250 6,190 C 8,140 12,96 24,62 C 38,22 70,4 110,4 Z" />
                </Grid.Resources>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Шапка: модель, заряд, связь, встроенный профиль -->
                <Border x:Name="MouseHeader" Style="{StaticResource Card}" Padding="18,12">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="MouseArtHost" Width="92" Height="70" Margin="0,0,16,0" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MouseName" Text="Мышь MCHOSE" FontSize="22" FontWeight="SemiBold" />
                            <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                <Border Width="30" Height="15" CornerRadius="3.5" BorderThickness="1.5" Padding="1.5"
                                        BorderBrush="{DynamicResource MutedBrush}" VerticalAlignment="Center">
                                    <Border x:Name="MouseBatteryFill" HorizontalAlignment="Left" Width="0" CornerRadius="1.5"
                                            Background="{DynamicResource GoodBrush}" />
                                </Border>
                                <Border Width="2.5" Height="6" Background="{DynamicResource MutedBrush}" VerticalAlignment="Center"
                                        CornerRadius="0,1,1,0" />
                                <TextBlock x:Name="MouseBatteryText" Text="—" Margin="8,0,0,0" FontSize="14" FontWeight="SemiBold"
                                           VerticalAlignment="Center" />
                                <TextBlock x:Name="MouseChargeText" Text="&#xE945;" FontFamily="Segoe MDL2 Assets" FontSize="13"
                                           Margin="6,0,0,0" VerticalAlignment="Center" Visibility="Collapsed"
                                           Foreground="{DynamicResource GoodBrush}" ToolTip="Заряжается" />
                                <TextBlock x:Name="MouseLinkText" Margin="14,0,0,0" VerticalAlignment="Center"
                                           Foreground="{DynamicResource MutedBrush}" />
                            </StackPanel>
                        </StackPanel>
                        <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="16,0,0,0">
                            <TextBlock Text="Профиль в мыши" Style="{StaticResource Cap}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                            <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4"
                                    ToolTip="Мышь хранит три профиля: свои кнопки, DPI и производительность в каждом">
                                <StackPanel Orientation="Horizontal">
                                    <RadioButton x:Name="MouseProfile0" Style="{StaticResource SegButton}" GroupName="MouseProfile"
                                                 Tag="0" Content="1" MinWidth="44" Checked="OnMouseProfile" />
                                    <RadioButton x:Name="MouseProfile1" Style="{StaticResource SegButton}" GroupName="MouseProfile"
                                                 Tag="1" Content="2" MinWidth="44" Checked="OnMouseProfile" />
                                    <RadioButton x:Name="MouseProfile2" Style="{StaticResource SegButton}" GroupName="MouseProfile"
                                                 Tag="2" Content="3" MinWidth="44" Checked="OnMouseProfile" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border x:Name="MouseTabs" Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4"
                        HorizontalAlignment="Left" Margin="0,16,0,14">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="MouseTabKeys" Style="{StaticResource SegButton}" GroupName="MouseTab"
                                     Content="Кнопки" IsChecked="True" Checked="OnMouseTab" />
                        <RadioButton x:Name="MouseTabDpi" Style="{StaticResource SegButton}" GroupName="MouseTab"
                                     Content="DPI" Checked="OnMouseTab" />
                        <RadioButton x:Name="MouseTabPerf" Style="{StaticResource SegButton}" GroupName="MouseTab"
                                     Content="Производительность" Checked="OnMouseTab" />
                        <RadioButton x:Name="MouseTabMore" Style="{StaticResource SegButton}" GroupName="MouseTab"
                                     Content="Прочее" Checked="OnMouseTab" />
                    </StackPanel>
                </Border>

                <Grid x:Name="MouseBody" Grid.Row="2">
                    <!-- ── Кнопки ── -->
                    <Grid x:Name="MouseKeysPanel">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="14" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>
                        <Border Style="{StaticResource Card}" Padding="16,14">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="*" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Viewbox Stretch="Uniform" StretchDirection="DownOnly" VerticalAlignment="Center">
                                    <Canvas Width="640" Height="394">
                                        <!-- мягкое свечение под мышью -->
                                        <Ellipse Canvas.Left="140" Canvas.Top="19" Width="360" Height="360" Fill="{DynamicResource MouseGlowBrush}"
                                                 IsHitTestVisible="False" />

                                        <!-- линии-выноски -->
                                        <Path x:Name="MouseKeyLine1" Data="M 470,49 H 400 L 320,72" />
                                        <Path x:Name="MouseKeyLine2" Data="M 470,125 H 410 L 352,116" />
                                        <Path x:Name="MouseKeyLine0" Data="M 170,125 H 245 L 288,116" />
                                        <Path x:Name="MouseKeyLine3" Data="M 170,211 H 205 L 233,211" />
                                        <Path x:Name="MouseKeyLine4" Data="M 170,293 H 205 L 233,266" />

                                        <!-- мышь сверху -->
                                        <Canvas Canvas.Left="210" Canvas.Top="16" Width="220" Height="366">
                                            <!-- Реальная фронтальная картинка мыши: как в M HUB. -->
                                            <Image Source="/RigControl;component/Assets/Devices/mouse-front.png"
                                                   Canvas.Left="13" Width="194" Height="366" Stretch="Fill"
                                                   IsHitTestVisible="False" />

                                            <!-- Прозрачные зоны поверх картинки остаются кликабельными. -->
                                            <Path x:Name="MouseZone0" Style="{StaticResource MouseZone}" MouseLeftButtonDown="OnMouseZoneClick"
                                                  Data="M 28,8 L 108,8 L 108,158 C 80,164 51,164 28,152 Z" />
                                            <Path x:Name="MouseZone2" Style="{StaticResource MouseZone}" MouseLeftButtonDown="OnMouseZoneClick"
                                                  Data="M 112,8 L 192,8 L 192,152 C 169,164 140,164 112,158 Z" />
                                            <Path x:Name="MouseZone1" Style="{StaticResource MouseKnob}" MouseLeftButtonDown="OnMouseZoneClick"
                                                  Fill="Transparent" Data="M 101,38 A 9,9 0 0 1 119,38 L 119,104 A 9,9 0 0 1 101,104 Z" />
                                            <Path x:Name="MouseZone3" Style="{StaticResource MouseKnob}" MouseLeftButtonDown="OnMouseZoneClick"
                                                  Fill="Transparent" Data="M 17,168 A 6,6 0 0 1 29,168 L 29,215 A 6,6 0 0 1 17,215 Z" />
                                            <Path x:Name="MouseZone4" Style="{StaticResource MouseKnob}" MouseLeftButtonDown="OnMouseZoneClick"
                                                  Fill="Transparent" Data="M 17,222 A 6,6 0 0 1 29,222 L 29,270 A 6,6 0 0 1 17,270 Z" />
                                        </Canvas>

                                        <Ellipse x:Name="MouseKeyDot1" Width="8" Height="8" Canvas.Left="316" Canvas.Top="68" IsHitTestVisible="False" />
                                        <Ellipse x:Name="MouseKeyDot2" Width="8" Height="8" Canvas.Left="348" Canvas.Top="112" IsHitTestVisible="False" />
                                        <Ellipse x:Name="MouseKeyDot0" Width="8" Height="8" Canvas.Left="284" Canvas.Top="112" IsHitTestVisible="False" />
                                        <Ellipse x:Name="MouseKeyDot3" Width="8" Height="8" Canvas.Left="229" Canvas.Top="207" IsHitTestVisible="False" />
                                        <Ellipse x:Name="MouseKeyDot4" Width="8" Height="8" Canvas.Left="229" Canvas.Top="262" IsHitTestVisible="False" />

                                        <!-- подписи кнопок -->
                                        <RadioButton x:Name="MouseKeyPick0" Style="{StaticResource CalloutButton}" GroupName="MouseKeyPick"
                                                     Tag="0" Canvas.Left="0" Canvas.Top="100" Checked="OnMouseKeyPick">
                                            <StackPanel>
                                                <TextBlock Text="ЛКМ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock x:Name="MouseKeyValue0" Text="Левый клик" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="MouseKeyPick3" Style="{StaticResource CalloutButton}" GroupName="MouseKeyPick"
                                                     Tag="3" Canvas.Left="0" Canvas.Top="186" Checked="OnMouseKeyPick">
                                            <StackPanel>
                                                <TextBlock Text="Вперёд · боковая" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock x:Name="MouseKeyValue3" Text="Вперёд" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="MouseKeyPick4" Style="{StaticResource CalloutButton}" GroupName="MouseKeyPick"
                                                     Tag="4" Canvas.Left="0" Canvas.Top="268" Checked="OnMouseKeyPick">
                                            <StackPanel>
                                                <TextBlock Text="Назад · боковая" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock x:Name="MouseKeyValue4" Text="Назад" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="MouseKeyPick1" Style="{StaticResource CalloutButton}" GroupName="MouseKeyPick"
                                                     Tag="1" Canvas.Left="470" Canvas.Top="24" Checked="OnMouseKeyPick">
                                            <StackPanel>
                                                <TextBlock Text="СКМ · колесо" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock x:Name="MouseKeyValue1" Text="Средний клик" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                        <RadioButton x:Name="MouseKeyPick2" Style="{StaticResource CalloutButton}" GroupName="MouseKeyPick"
                                                     Tag="2" Canvas.Left="470" Canvas.Top="100" Checked="OnMouseKeyPick">
                                            <StackPanel>
                                                <TextBlock Text="ПКМ" FontSize="11" FontWeight="SemiBold" Foreground="{DynamicResource MutedBrush}" />
                                                <TextBlock x:Name="MouseKeyValue2" Text="Правый клик" FontSize="13.5" FontWeight="SemiBold"
                                                           Margin="0,1,0,0" TextTrimming="CharacterEllipsis" />
                                            </StackPanel>
                                        </RadioButton>
                                    </Canvas>
                                </Viewbox>
                                <DockPanel Grid.Row="1" Margin="0,10,0,0">
                                    <Button DockPanel.Dock="Right" Content="Сбросить все" Click="OnMouseKeysResetAll"
                                            ToolTip="Все кнопки текущего профиля — как с завода" />
                                    <Button x:Name="MouseKeyResetButton" DockPanel.Dock="Right" Content="Вернуть родную" Margin="0,0,8,0"
                                            Click="OnMouseKeyReset" ToolTip="Вернуть выбранной кнопке её обычную функцию" />
                                    <TextBlock Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,12,0"
                                               Text="Выберите кнопку на схеме, затем — функцию справа." />
                                </DockPanel>
                            </Grid>
                        </Border>

                        <Border Grid.Column="2" Style="{StaticResource Card}" Padding="14,14,6,8">
                            <DockPanel>
                                <StackPanel DockPanel.Dock="Top" Margin="2,0,8,8">
                                    <TextBlock x:Name="MouseKeyTitle" Text="Левая кнопка" Style="{StaticResource H2}" />
                                    <TextBlock x:Name="MouseKeyCurrent" Style="{StaticResource Cap}" Margin="0,2,0,10" TextTrimming="CharacterEllipsis"
                                               TextWrapping="NoWrap" />
                                    <Grid>
                                        <TextBox x:Name="MouseKeySearch" TextChanged="OnMouseKeySearch" PreviewKeyDown="OnMouseKeySearchKey" />
                                        <TextBlock x:Name="MouseKeySearchHint" Text="Поиск функции" IsHitTestVisible="False" Margin="12,0,0,0"
                                                   VerticalAlignment="Center" Foreground="{DynamicResource MutedBrush}" />
                                    </Grid>
                                </StackPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="0,0,4,0">
                                    <StackPanel x:Name="MouseKeyList" />
                                </ScrollViewer>
                            </DockPanel>
                        </Border>
                    </Grid>

                    <!-- ── DPI ── -->
                    <ScrollViewer x:Name="MouseDpiPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border Style="{StaticResource Card}" Padding="18,12" Margin="0,0,0,14">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Content="Сброс" Click="OnMouseDpiReset" VerticalAlignment="Center"
                                            x:Name="MouseDpiResetButton" />
                                    <CheckBox x:Name="MouseDpiXY" DockPanel.Dock="Right" Style="{StaticResource Switch}" Margin="0,0,22,0"
                                              VerticalAlignment="Center" Click="OnMouseDpiXY"
                                              ToolTip="Своя чувствительность по вертикали — например, для игр с прицелом">
                                        <TextBlock Text="Отдельно X и Y" FontWeight="SemiBold" />
                                    </CheckBox>
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="Уровней" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,12,0" />
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4">
                                            <StackPanel x:Name="MouseDpiCount" Orientation="Horizontal" />
                                        </Border>
                                    </StackPanel>
                                </DockPanel>
                            </Border>
                            <UniformGrid x:Name="MouseDpiCards" Columns="2" Margin="0,0,-14,0" />
                            <TextBlock Style="{StaticResource Cap}" Margin="2,0,0,0"
                                       Text="Нажмите на уровень, чтобы сделать его текущим. На мыши уровни переключает кнопка под колесом — индикатор загорается цветом уровня." />
                        </StackPanel>
                    </ScrollViewer>

                    <!-- ── Производительность ── -->
                    <ScrollViewer x:Name="MousePerfPanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Сенсор" Style="{StaticResource H2}" />
                                        <TextBlock Text="Режим работы" FontWeight="SemiBold" Margin="0,14,0,8" />
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4">
                                            <UniformGrid Rows="1">
                                                <RadioButton x:Name="MouseMode0" Style="{StaticResource SegButton}" GroupName="MouseMode" Tag="0" Padding="6,7"
                                                             Checked="OnMouseMode" ToolTip="В M HUB — «Режим мощности»: экономит батарею">
                                                    <StackPanel>
                                                        <TextBlock Text="Эко" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="дольше заряд" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="MouseMode1" Style="{StaticResource SegButton}" GroupName="MouseMode" Tag="1" Padding="6,7"
                                                             Checked="OnMouseMode" ToolTip="«Игровой режим»: быстрее отклик, батарея садится быстрее">
                                                    <StackPanel>
                                                        <TextBlock Text="Игровой" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="быстрее отклик" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                                <RadioButton x:Name="MouseMode2" Style="{StaticResource SegButton}" GroupName="MouseMode" Tag="2" Padding="6,7"
                                                             Checked="OnMouseMode" ToolTip="«Суперрежим»: максимум сенсора; нужна свежая прошивка мыши и приёмника">
                                                    <StackPanel>
                                                        <TextBlock Text="Супер" FontWeight="SemiBold" HorizontalAlignment="Center" />
                                                        <TextBlock Text="максимум" FontSize="11" Opacity="0.75" HorizontalAlignment="Center" />
                                                    </StackPanel>
                                                </RadioButton>
                                            </UniformGrid>
                                        </Border>

                                        <TextBlock Text="Частота опроса, Гц" FontWeight="SemiBold" Margin="0,16,0,8" />
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                                            <StackPanel x:Name="MouseRates" Orientation="Horizontal" />
                                        </Border>
                                        <TextBlock x:Name="MouseRateNote" Style="{StaticResource Cap}" Margin="0,6,0,0" />

                                        <TextBlock Text="Высота отрыва" FontWeight="SemiBold" Margin="0,16,0,8" />
                                        <Border Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4" HorizontalAlignment="Left">
                                            <StackPanel Orientation="Horizontal">
                                                <RadioButton x:Name="MouseLod0" Style="{StaticResource SegButton}" GroupName="MouseLod" Tag="0"
                                                             Content="0,7 мм" Checked="OnMouseLod" />
                                                <RadioButton x:Name="MouseLod1" Style="{StaticResource SegButton}" GroupName="MouseLod" Tag="1"
                                                             Content="1 мм" Checked="OnMouseLod" />
                                                <RadioButton x:Name="MouseLod2" Style="{StaticResource SegButton}" GroupName="MouseLod" Tag="2"
                                                             Content="2 мм" Checked="OnMouseLod" />
                                            </StackPanel>
                                        </Border>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Тест частоты опроса" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,10"
                                                   Text="Наведите курсор на поле и быстро водите мышью по кругу." />
                                        <Border Height="100" CornerRadius="10" Background="{DynamicResource Surface2Brush}"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" ClipToBounds="True" Cursor="Cross"
                                                MouseEnter="OnRatePadEnter" MouseLeave="OnRatePadLeave">
                                            <Grid>
                                                <Canvas x:Name="MouseRateCanvas" IsHitTestVisible="False">
                                                    <Polyline x:Name="MouseRateGraph" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2"
                                                              StrokeLineJoin="Round" Opacity="0.5" />
                                                </Canvas>
                                                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False">
                                                    <TextBlock x:Name="MouseRateNow" Text="—" FontSize="30" FontWeight="SemiBold"
                                                               HorizontalAlignment="Center" />
                                                    <TextBlock x:Name="MouseRateSub" Style="{StaticResource Cap}" HorizontalAlignment="Center"
                                                               Text="Гц" />
                                                </StackPanel>
                                            </Grid>
                                        </Border>
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Клик и движение" Style="{StaticResource H2}" />

                                        <TextBlock Text="Задержка кнопки (антидребезг), мс" FontWeight="SemiBold" Margin="0,14,0,2" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,4"
                                                   Text="Меньше — быстрее клик; если появился двойной клик — прибавьте." />
                                        <DockPanel>
                                            <TextBlock x:Name="MouseDebounceText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Text="—" />
                                            <Slider x:Name="MouseDebounce" Minimum="0" Maximum="20" SmallChange="1" LargeChange="2"
                                                    IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnMouseDebounce" />
                                        </DockPanel>

                                        <DockPanel Margin="0,14,0,2">
                                            <Button x:Name="MouseRotateReset" DockPanel.Dock="Right" Style="{StaticResource LinkButton}"
                                                    Content="Вернуть 0°" Click="OnMouseRotateReset" Visibility="Hidden" VerticalAlignment="Center" />
                                            <TextBlock Text="Поворот сенсора" FontWeight="SemiBold" />
                                        </DockPanel>
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,0,0,4" Text="Подстройка угла под ваш хват, −30…30°." />
                                        <DockPanel>
                                            <TextBlock x:Name="MouseRotateText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Text="0°" />
                                            <Slider x:Name="MouseRotate" Minimum="-30" Maximum="30" SmallChange="1" LargeChange="5"
                                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                    ValueChanged="OnMouseRotate" />
                                        </DockPanel>

                                        <CheckBox x:Name="MouseMotionSync" Style="{StaticResource Switch}" Tag="motionSync" Click="OnMouseToggle"
                                                  Margin="0,16,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Motion Sync" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Cap}" Text="Ровнее движение, примерно +1 мс задержки." />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="MouseRipple" Style="{StaticResource Switch}" Tag="ripple" Click="OnMouseToggle"
                                                  Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Ripple Control" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Cap}" Text="Убирает дрожание курсора на высоком DPI." />
                                            </StackPanel>
                                        </CheckBox>
                                        <CheckBox x:Name="MouseAngleSnap" Style="{StaticResource Switch}" Tag="line" Click="OnMouseToggle"
                                                  Margin="0,12,0,0">
                                            <StackPanel>
                                                <TextBlock Text="Angle Snapping" FontWeight="SemiBold" />
                                                <TextBlock Style="{StaticResource Cap}" Text="Выпрямляет линии. В играх обычно выключают." />
                                            </StackPanel>
                                        </CheckBox>
                                    </StackPanel>
                                </Border>

                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Сон" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,6"
                                                   Text="Без движения мышь засыпает через это время, минут. Будит клик." />
                                        <DockPanel>
                                            <CheckBox x:Name="MouseNeverSleep" DockPanel.Dock="Right" Content="Не засыпать" Margin="14,0,0,0"
                                                      VerticalAlignment="Center" Click="OnMouseNeverSleep" />
                                            <TextBlock x:Name="MouseSleepText" DockPanel.Dock="Right" Width="40" TextAlignment="Right"
                                                       FontWeight="SemiBold" VerticalAlignment="Center" Text="—" />
                                            <Slider x:Name="MouseSleep" Minimum="1" Maximum="60" SmallChange="1" LargeChange="5"
                                                    IsSnapToTickEnabled="True" TickFrequency="1" VerticalAlignment="Center"
                                                    ValueChanged="OnMouseSleep" />
                                        </DockPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>

                    <!-- ── Прочее ── -->
                    <ScrollViewer x:Name="MouseMorePanel" Visibility="Collapsed" VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="14" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Об устройстве" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                        <Grid x:Name="MouseAboutGrid">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="150" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                        </Grid>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Заводские настройки" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,12"
                                                   Text="Кнопки, DPI и производительность текущего профиля станут как с завода. Будьте осторожны: отменить нельзя." />
                                        <Button x:Name="MouseFactoryButton" Content="Сбросить профиль" HorizontalAlignment="Left"
                                                Click="OnMouseFactoryReset" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>

                            <StackPanel Grid.Column="2">
                                <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                                    <StackPanel>
                                        <TextBlock Text="Шпаргалка" Style="{StaticResource H2}" Margin="0,0,0,8" />
                                        <TextBlock Style="{StaticResource Cap}" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Донгл 2.4G:" />
                                            <Run Text="переключатель — 2.4G. Чтобы привязать заново, выньте приёмник из адаптера, зажмите ЛКМ + СКМ + ПКМ на 5 секунд (индикатор часто мигает зелёным), вставьте приёмник обратно и держите мышь ближе 20 см." />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,8,0,0" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Bluetooth:" />
                                            <Run Text="переключатель — B, выберите «MCHOSE A7 Ultra» в списке устройств. Не подключается — зажмите те же три кнопки на 3 секунды и повторите. Настройки из программы — через донгл или кабель." />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,8,0,0" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Кабель:" />
                                            <Run Text="мышь сама переходит на провод и заряжается. Лучше заряжать от USB компьютера." />
                                        </TextBlock>
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,8,0,0" TextWrapping="Wrap">
                                            <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Индикатор:" />
                                            <Run Text="мигает красным — пора заряжать, горит красным — заряжается, горит зелёным — заряжена." />
                                        </TextBlock>
                                    </StackPanel>
                                </Border>
                                <Border Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Диагностика" Style="{StaticResource H2}" Margin="0,0,0,10" />
                                        <StackPanel Orientation="Horizontal">
                                            <Button Content="Найти мышь заново" Click="OnMouseRescan" />
                                            <CheckBox x:Name="MouseDiagToggle" Content="Журнал обмена" Margin="16,0,0,0" VerticalAlignment="Center"
                                                      Click="OnMouseDiagToggle" />
                                        </StackPanel>
                                        <TextBox x:Name="MouseDiag" Margin="0,12,0,0" Height="140" IsReadOnly="True" TextWrapping="Wrap"
                                                 VerticalScrollBarVisibility="Auto" FontFamily="Consolas" FontSize="11" Visibility="Collapsed" />
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Grid>
                    </ScrollViewer>
                </Grid>

                <!-- Короткие сообщения («Сохранено в мышь», ошибки) — всплывают снизу и не сдвигают страницу -->
                <Border x:Name="MouseToast" Grid.RowSpan="3" Panel.ZIndex="20" HorizontalAlignment="Center" VerticalAlignment="Bottom"
                        Margin="0,0,0,10" Padding="16,9" CornerRadius="10" MaxWidth="560" IsHitTestVisible="False"
                        Background="{DynamicResource TextBrush}" Effect="{DynamicResource SoftShadow}" Visibility="Collapsed">
                    <TextBlock x:Name="MouseToastText" Foreground="{DynamicResource CardBrush}" FontWeight="SemiBold"
                               TextWrapping="Wrap" TextAlignment="Center" />
                </Border>

                <!-- Мыши нет: одна карточка вместо пустых настроек -->
                <Border x:Name="MouseEmpty" Grid.RowSpan="3" Style="{StaticResource Card}" Padding="32,28" VerticalAlignment="Top"
                        Visibility="Collapsed">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <ContentControl x:Name="MouseEmptyArt" Width="190" Height="160" Margin="0,0,32,0" Opacity="0.9" />
                        <StackPanel Grid.Column="1" VerticalAlignment="Center">
                            <TextBlock x:Name="MouseEmptyTitle" Text="Мышь не найдена" FontSize="22" FontWeight="SemiBold" />
                            <TextBlock x:Name="MouseEmptyText" Style="{StaticResource Cap}" Margin="0,6,0,16" FontSize="13.5"
                                       Text="Подключите донгл 2,4 ГГц или кабель. Если открыт M HUB — закройте его." />
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource AccentButton}" Content="Найти снова" Padding="20,8" Click="OnMouseRescan" />
                            </StackPanel>
                            <TextBlock Style="{StaticResource Cap}" Margin="0,18,0,0" TextWrapping="Wrap">
                                <Run FontWeight="SemiBold" Foreground="{DynamicResource TextBrush}" Text="Донгл не видит мышь?" />
                                <Run Text="Выньте приёмник из адаптера, зажмите ЛКМ + СКМ + ПКМ на 5 секунд (индикатор часто мигает зелёным), вставьте приёмник обратно и держите мышь ближе 20 см. По Bluetooth настройки недоступны — нужен донгл или кабель." />
                            </TextBlock>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- ───────── Помпа ───────── -->
            <Grid x:Name="PagePump" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="350" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0" Margin="0,0,22,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <StackPanel Grid.Row="0">
                        <TextBlock Text="Экран помпы" Style="{StaticResource H1}" />
                        <TextBlock x:Name="CoolerInfo" Style="{StaticResource Cap}" Margin="0,4,0,0" Text="Помпа не найдена" />
                    </StackPanel>

                    <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4"
                            HorizontalAlignment="Left" Margin="0,16,0,14">
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="CoolerModeMonitor" Style="{StaticResource SegButton}" GroupName="CoolerMode"
                                         Content="Редактор экрана" IsChecked="True" Checked="OnCoolerModeChanged" />
                            <RadioButton x:Name="CoolerModeImage" Style="{StaticResource SegButton}" GroupName="CoolerMode"
                                         Content="Картинка или гифка" Checked="OnCoolerModeChanged" />
                        </StackPanel>
                    </Border>

                    <Border Grid.Row="2" Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource PressedBrush}" BorderThickness="3"
                            CornerRadius="10" Padding="16" MinHeight="300">
                        <Grid>
                            <Viewbox x:Name="SceneViewbox" Stretch="Uniform" StretchDirection="Both">
                                <Grid x:Name="SceneHost" Background="Transparent" Focusable="True"
                                      FocusVisualStyle="{x:Null}"
                                      MouseLeftButtonDown="OnSceneDown" MouseMove="OnSceneMove"
                                      MouseLeftButtonUp="OnSceneUp" MouseWheel="OnSceneWheel"
                                      KeyDown="OnSceneKeyDown">
                                    <Canvas x:Name="SceneCanvas" Width="320" Height="240" />
                                    <Canvas x:Name="OverlayCanvas" IsHitTestVisible="False">
                                        <Rectangle x:Name="SelectionRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1.2"
                                                   StrokeDashArray="3 2" Visibility="Collapsed" />
                                        <Rectangle x:Name="MarqueeRect" Stroke="{DynamicResource AccentBrush}" StrokeThickness="1"
                                                   Fill="#263B82F6" Visibility="Collapsed" />
                                    </Canvas>
                                </Grid>
                            </Viewbox>
                            <Image x:Name="CoolerPreview" Stretch="Uniform" Visibility="Collapsed" />
                        </Grid>
                    </Border>

                    <Grid Grid.Row="3" Margin="0,12,0,0">
                        <StackPanel x:Name="EditorToolbar" Orientation="Horizontal">
                            <Button x:Name="AddButton" Content="+  Добавить объект" Click="OnAddClick" />
                            <Popup x:Name="AddPopup" PlacementTarget="{Binding ElementName=AddButton}" Placement="Bottom"
                                   StaysOpen="False" AllowsTransparency="True" PopupAnimation="Fade">
                                <Border Background="{DynamicResource CardBrush}" BorderBrush="{DynamicResource LineBrush}"
                                        BorderThickness="1" CornerRadius="8" Padding="6" Margin="6,6,12,12"
                                        Effect="{DynamicResource SoftShadow}">
                                    <UniformGrid Columns="2" Width="340">
                                        <Button Style="{StaticResource MenuButton}" Content="Время" Tag="Time" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Дата" Tag="Date" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="День недели" Tag="Weekday" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Аптайм" Tag="Uptime" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Загрузка CPU" Tag="CpuLoad" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Температура CPU" Tag="CpuTemp" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Частота CPU" Tag="CpuClock" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Мощность CPU" Tag="CpuPower" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Загрузка GPU" Tag="GpuLoad" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Температура GPU" Tag="GpuTemp" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Мощность GPU" Tag="GpuPower" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Видеопамять" Tag="Vram" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Память (RAM)" Tag="Ram" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Диск" Tag="Disk" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Сеть ↓" Tag="NetDown" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Сеть ↑" Tag="NetUp" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Полоса CPU" Tag="CpuBar" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Полоса GPU" Tag="GpuBar" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Полоса RAM" Tag="RamBar" Click="OnAddKind" />
                                        <Button Style="{StaticResource MenuButton}" Content="Свой текст" Tag="Text" Click="OnAddKind" />
                                    </UniformGrid>
                                </Border>
                            </Popup>
                            <Button x:Name="DeleteButton" Content="Удалить  (Del)" Margin="8,0,0,0" Click="OnDeleteClick" IsEnabled="False" />
                            <Button x:Name="ResetLayoutButton" Content="Сбросить" Margin="8,0,0,0" Click="OnResetLayout" />
                        </StackPanel>

                        <StackPanel x:Name="ImageToolbar" Orientation="Horizontal" Visibility="Collapsed">
                            <Button x:Name="CoolerPickButton" Content="Выбрать картинку или гифку…" Click="OnCoolerPick" />
                        </StackPanel>
                    </Grid>

                    <Grid Grid.Row="4" Margin="0,14,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <Button x:Name="CoolerStartButton" Grid.Column="0" Style="{StaticResource AccentButton}"
                                Content="Запустить" Padding="14,12" FontSize="14" Click="OnCoolerStartStop" IsEnabled="False" />
                        <TextBlock x:Name="CoolerFpsText" Grid.Column="1" Style="{StaticResource Cap}"
                                   VerticalAlignment="Center" Margin="14,0,0,0" TextWrapping="NoWrap" />
                    </Grid>
                </Grid>

                <ScrollViewer Grid.Column="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel Margin="0,0,6,0">

                        <Border x:Name="ThemeCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Темы" Style="{StaticResource H2}" />
                                <UniformGrid x:Name="ThemePanel" Columns="2" Margin="-4,6,-4,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="BgCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Фон" Style="{StaticResource H2}" />
                                <TextBlock x:Name="BgName" Style="{StaticResource Cap}" Margin="0,6,0,0"
                                           Text="Стандартный тёмный фон" TextTrimming="CharacterEllipsis" TextWrapping="NoWrap" />
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <TextBlock Text="Цвета" Style="{StaticResource Cap}" VerticalAlignment="Center" Margin="0,0,10,0" />
                                    <Border x:Name="BgTopSwatch" Width="34" Height="30" CornerRadius="8" Cursor="Hand"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="#10121A"
                                            ToolTip="Верх" MouseLeftButtonUp="OnBgColorClick" Tag="top" />
                                    <Border x:Name="BgBottomSwatch" Width="34" Height="30" CornerRadius="8" Cursor="Hand" Margin="6,0,0,0"
                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="#05060A"
                                            ToolTip="Низ" MouseLeftButtonUp="OnBgColorClick" Tag="bottom" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                    <Button x:Name="BgButton" Content="Выбрать картинку…" Click="OnBgPick" />
                                    <Button x:Name="BgResetButton" Content="Сброс" Margin="8,0,0,0" Click="OnBgReset" />
                                </StackPanel>
                                <TextBlock x:Name="BgBrightnessLabel" Text="Яркость фона: 100%" Margin="0,14,0,2" />
                                <Slider x:Name="BgBrightness" Minimum="0" Maximum="100" Value="100" SmallChange="1"
                                        LargeChange="10" ValueChanged="OnBgBrightnessChanged" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="PropCard" Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Объект" Style="{StaticResource H2}" />
                                <TextBlock x:Name="PropHint" Style="{StaticResource Cap}" Margin="0,6,0,0"
                                           Text="Выберите объект на экране. Несколько — обведите рамкой, зажав левую кнопку мыши на пустом месте, или щёлкайте с Ctrl. Ctrl+A — все." />
                                <StackPanel x:Name="PropBody" Margin="0,10,0,0" IsEnabled="False" Opacity="0.45">
                                    <TextBlock x:Name="PropTitle" FontWeight="SemiBold"
                                               Foreground="{DynamicResource AccentHoverBrush}" />

                                    <StackPanel x:Name="PropTextRow" Margin="0,10,0,0" Visibility="Collapsed">
                                        <TextBlock Text="Текст" Style="{StaticResource Cap}" />
                                        <TextBox x:Name="PropText" Margin="0,4,0,0" TextChanged="OnPropTextChanged" />
                                    </StackPanel>

                                    <WrapPanel Margin="0,12,0,0">
                                        <CheckBox x:Name="PropLabel" Content="Подпись" Margin="0,0,16,6" Click="OnPropFlagChanged" />
                                        <CheckBox x:Name="PropSeconds" Content="Секунды" Margin="0,0,16,6" Click="OnPropFlagChanged" />
                                        <CheckBox x:Name="PropBold" Content="Жирный" Margin="0,0,0,6" Click="OnPropFlagChanged" />
                                    </WrapPanel>

                                    <TextBlock Text="Шрифт" Style="{StaticResource Cap}" Margin="0,4,0,4" />
                                    <ComboBox x:Name="PropFont" SelectionChanged="OnPropFontChanged" />

                                    <TextBlock Text="Цвет" Style="{StaticResource Cap}" Margin="0,12,0,6" />
                                    <WrapPanel x:Name="PropSwatches" />
                                    <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                        <Border x:Name="PropWheelButton" Width="34" Height="30" CornerRadius="8" Cursor="Hand"
                                                BorderBrush="{DynamicResource LineBrush}" BorderThickness="1"
                                                ToolTip="Палитра" MouseLeftButtonUp="OnPropWheelClick" Margin="0,0,8,0">
                                            <Border.Background>
                                                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                                                    <GradientStop Color="#FF0000" Offset="0" />
                                                    <GradientStop Color="#FFFF00" Offset="0.2" />
                                                    <GradientStop Color="#00FF00" Offset="0.4" />
                                                    <GradientStop Color="#00FFFF" Offset="0.6" />
                                                    <GradientStop Color="#0000FF" Offset="0.8" />
                                                    <GradientStop Color="#FF00FF" Offset="1" />
                                                </LinearGradientBrush>
                                            </Border.Background>
                                        </Border>
                                        <TextBox x:Name="PropColorBox" Width="120" TextChanged="OnPropColorTextChanged" />
                                        <Button x:Name="PropColorAuto" Content="Авто" Margin="8,0,0,0" Padding="12,6"
                                                Click="OnPropColorAuto" Visibility="Collapsed" />
                                    </StackPanel>

                                    <TextBlock x:Name="PropScaleLabel" Text="Размер: 100%" Margin="0,14,0,2" />
                                    <Slider x:Name="PropScale" Minimum="0.3" Maximum="4" Value="1" SmallChange="0.05"
                                            LargeChange="0.25" ValueChanged="OnPropScaleChanged" />
                                </StackPanel>
                            </StackPanel>
                        </Border>


                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Вывод на экран" Style="{StaticResource H2}" />
                                <TextBlock x:Name="FpsLabel" Text="Частота: 2 кадр/с" Margin="0,10,0,2" />
                                <Slider x:Name="FpsSlider" Minimum="1" Maximum="10" Value="2" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="OnFpsChanged" />

                                <TextBlock Text="Поворот" Style="{StaticResource Cap}" Margin="0,14,0,4" />
                                <ComboBox x:Name="CoolerRotationCombo" SelectionChanged="OnCoolerOptionChanged">
                                    <ComboBoxItem Content="0°" Tag="0" IsSelected="True" />
                                    <ComboBoxItem Content="90°" Tag="90" />
                                    <ComboBoxItem Content="180°" Tag="180" />
                                    <ComboBoxItem Content="270°" Tag="270" />
                                </ComboBox>

                                <TextBlock Text="Размер экрана" Style="{StaticResource Cap}" Margin="0,12,0,4" />
                                <ComboBox x:Name="CoolerSizeCombo" SelectionChanged="OnCoolerOptionChanged">
                                    <ComboBoxItem Content="Авто (по ответу помпы)" Tag="0x0" IsSelected="True" />
                                    <ComboBoxItem Content="320 × 320" Tag="320x320" />
                                    <ComboBoxItem Content="320 × 240" Tag="320x240" />
                                    <ComboBoxItem Content="240 × 320" Tag="240x320" />
                                    <ComboBoxItem Content="640 × 480" Tag="640x480" />
                                </ComboBox>

                                <Button x:Name="CoolerFindButton" Content="Найти помпу заново" Margin="0,14,0,0"
                                        Click="OnCoolerFind" />

                                <CheckBox x:Name="DiagCheck" Content="Показать диагностику" Margin="0,14,0,0"
                                          Click="OnToggleDiag" />
                                <StackPanel x:Name="DiagPanel" Visibility="Collapsed" Margin="0,8,0,0">
                                    <TextBox x:Name="CoolerLog" Height="120" IsReadOnly="True" TextWrapping="Wrap"
                                             FontFamily="Consolas" FontSize="11.5" />
                                    <Button x:Name="CoolerResetButton" Content="Сбросить USB экрана" Margin="0,8,0,0"
                                            HorizontalAlignment="Left" Click="OnCoolerReset" />
                                </StackPanel>
                            </StackPanel>
                        </Border>

                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── Вентиляторы (скорость, разъёмы платы) ───────── -->
            <Grid x:Name="PageFans" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Вентиляторы" Style="{StaticResource H1}" />
                        <TextBlock x:Name="FansBoardText" Style="{StaticResource Cap}" Margin="0,4,0,18" TextWrapping="Wrap"
                                   Text="Поиск датчиков платы…" />

                        <StackPanel x:Name="FansList" />

                        <Border Style="{StaticResource Card}" Margin="0,4,0,0">
                            <TextBlock Style="{StaticResource Cap}" TextWrapping="Wrap"
                                       Text="Режимы «Тихий», «Обычный», «Производительный» и «Своя кривая» меняют скорость по температуре CPU. Если CPU горячее 90 °C — все управляемые вентиляторы на 100 %. Меньше 20 % поставить нельзя. При выходе из программы управление возвращается плате (BIOS). Помпу СЖО лучше оставить на «Авто» или «Максимум». Чтобы узнать, какой канал какой, поставьте «Максимум» и посмотрите, чьи обороты выросли." />
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── Подсветка СЖО (ARGB-разъём платы ASUS) ───────── -->
            <Grid x:Name="PageArgb" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <Grid Margin="0,0,0,18">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel>
                                <TextBlock Text="Подсветка СЖО" Style="{StaticResource H1}" />
                                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Разъём ARGB на материнской плате ASUS (контроллер AURA по USB)." />
                            </StackPanel>
                            <Button x:Name="ArgbFindButton" Grid.Column="1" Content="Найти снова" VerticalAlignment="Top"
                                    Click="OnArgbFind" />
                        </Grid>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <StackPanel Orientation="Horizontal">
                                    <Ellipse x:Name="ArgbStatusDot" Width="9" Height="9" Fill="{DynamicResource BadBrush}"
                                             VerticalAlignment="Center" Margin="0,0,8,0" />
                                    <TextBlock x:Name="ArgbStatusText" Text="Не управляется" FontWeight="SemiBold" TextWrapping="Wrap" />
                                </StackPanel>
                                <StackPanel x:Name="ArmouryPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Cap}" TextWrapping="Wrap"
                                               Text="Запущена служба подсветки Armoury Crate (LightingService). Она тоже управляет разъёмом и будет перебивать цвета. Её можно остановить — Armoury Crate останется, но перестанет менять подсветку." />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="ArmouryStopButton" Content="Остановить службу подсветки" Click="OnArmouryStop" />
                                    </StackPanel>
                                </StackPanel>
                                <StackPanel x:Name="ArmouryOffPanel" Visibility="Collapsed" Margin="0,12,0,0">
                                    <TextBlock Style="{StaticResource Cap}" TextWrapping="Wrap"
                                               Text="Служба подсветки Armoury Crate остановлена этой программой." />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <Button x:Name="ArmouryStartButton" Content="Вернуть службу" Click="OnArmouryStart" />
                                    </StackPanel>
                                </StackPanel>
                            </StackPanel>
                        </Border>

                        <Border x:Name="ArgbPreviewCard" Style="{StaticResource Card}" Margin="0,0,0,14" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Сейчас горит" Style="{StaticResource H2}" />
                                <WrapPanel x:Name="ArgbPreview" Margin="0,12,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="Эффект" Style="{StaticResource Cap}" Margin="0,0,0,4" />
                                <ComboBox x:Name="ArgbModeCombo" SelectionChanged="OnArgbChanged">
                                    <ComboBoxItem Content="Не управлять (как в Armoury Crate)" />
                                    <ComboBoxItem Content="Выключено" />
                                    <ComboBoxItem Content="Цвет" />
                                    <ComboBoxItem Content="Дыхание" />
                                    <ComboBoxItem Content="Смена цветов" />
                                    <ComboBoxItem Content="Радужная волна" />
                                    <ComboBoxItem Content="Бегущий огонёк" />
                                    <ComboBoxItem Content="По температуре CPU" />
                                    <ComboBoxItem Content="Как клавиатура" />
                                </ComboBox>
                                <TextBlock x:Name="ArgbModeHint" Style="{StaticResource Cap}" Margin="0,6,0,0" TextWrapping="Wrap" />
                                <Border x:Name="SpectrumCalPanel" Visibility="Collapsed" Margin="0,12,0,0" Padding="12"
                                        CornerRadius="6" Background="{DynamicResource Surface2Brush}">
                                    <StackPanel>
                                        <Grid>
                                            <TextBlock Text="Синхронно с клавиатурой" FontWeight="SemiBold" VerticalAlignment="Center" />
                                            <CheckBox x:Name="EffectRateToggle" Content="Подогнать скорость" HorizontalAlignment="Right"
                                                      Click="OnEffectRateToggle" />
                                        </Grid>
                                        <StackPanel x:Name="EffectRateTools" Visibility="Collapsed">
                                        <TextBlock x:Name="EffectRateLabel" Style="{StaticResource Cap}" Margin="0,4,0,4" TextWrapping="Wrap" />
                                        <Slider x:Name="EffectRateSlider" Minimum="0.1" Maximum="3" SmallChange="0.01" LargeChange="0.05"
                                                TickFrequency="0.01" IsSnapToTickEnabled="True" Value="1" ValueChanged="OnEffectRateChanged" />
                                        <StackPanel x:Name="SpectrumCalButtons">
                                            <TextBlock x:Name="SpectrumCalText" Style="{StaticResource Cap}" Margin="0,8,0,8" TextWrapping="Wrap" />
                                            <Button x:Name="SpectrumCalButton" Content="Старт" Click="OnSpectrumCal" HorizontalAlignment="Left" />
                                        </StackPanel>
                                        </StackPanel>
                                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                                            <Button x:Name="EffectRestartButton" Content="Начать одновременно" Click="OnEffectRestart"
                                                    ToolTip="Перезапустить эффект на клавиатуре — схема и вентиляторы начнут вместе с ней" />
                                            <Button x:Name="SpectrumResetButton" Content="Сбросить подгонку" Margin="8,0,0,0" Click="OnSpectrumCalReset"
                                                    Visibility="{Binding Visibility, ElementName=EffectRateTools}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>

                                <StackPanel x:Name="ArgbColorPanel">
                                    <TextBlock Text="Цвет" Style="{StaticResource Cap}" Margin="0,16,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <ContentControl x:Name="ArgbWheelHost" Grid.Column="0" VerticalAlignment="Top" />
                                        <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                            <WrapPanel x:Name="ArgbSwatches" />
                                            <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                <Border x:Name="ArgbColorSwatch" Width="38" Height="34" CornerRadius="6"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="White" />
                                                <TextBox x:Name="ArgbColorBox" Width="110" Margin="8,0,0,0" TextChanged="OnArgbColorText" />
                                            </StackPanel>
                                            <CheckBox x:Name="ArgbRainbowCheck" Content="Радуга (выкл. для нескольких цветов)" Margin="0,8,0,0"
                                                      IsChecked="True" Click="OnArgbRainbowChanged" />
                                            <StackPanel x:Name="ArgbPalettePanel" Margin="0,8,0,0">
                                                <TextBlock Text="Дополнительные цвета волны" Style="{StaticResource Cap}" Margin="0,0,0,4" />
                                            <StackPanel Orientation="Horizontal">
                                                <Border x:Name="ArgbColor2Swatch" Width="38" Height="38" CornerRadius="19"
                                                        BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                                        Background="#FF00A8" Cursor="Hand"
                                                        ToolTip="Выбрать второй цвет" MouseLeftButtonUp="OnArgbColor2Click" />
                                                <Border x:Name="ArgbColor3Swatch" Width="38" Height="38" Margin="10,0,0,0"
                                                        CornerRadius="19" BorderBrush="{DynamicResource LineBrush}" BorderThickness="2"
                                                        Background="#8A2BFF" Cursor="Hand"
                                                        ToolTip="Выбрать третий цвет" MouseLeftButtonUp="OnArgbColor3Click" />
                                                <!-- Значения хранятся в полях, но пользователю HEX больше не показывается. -->
                                                <TextBox x:Name="ArgbColor2Box" Visibility="Collapsed" TextChanged="OnArgbColorText" />
                                                <TextBox x:Name="ArgbColor3Box" Visibility="Collapsed" TextChanged="OnArgbColorText" />
                                            </StackPanel>
                                            </StackPanel>
                                        </StackPanel>
                                    </Grid>
                                </StackPanel>

                                <TextBlock x:Name="ArgbBrightnessLabel" Text="Яркость: 100%" Margin="0,18,0,2" />
                                <Slider x:Name="ArgbBrightness" Minimum="0" Maximum="100" Value="100" SmallChange="1"
                                        LargeChange="10" ValueChanged="OnArgbSlider" />

                                <StackPanel x:Name="ArgbSpeedPanel">
                                    <TextBlock x:Name="ArgbSpeedLabel" Text="Скорость: 3" Margin="0,12,0,2" />
                                    <Slider x:Name="ArgbSpeed" Minimum="1" Maximum="5" TickFrequency="1"
                                            IsSnapToTickEnabled="True" Value="3" ValueChanged="OnArgbSlider" />
                                </StackPanel>

                                <TextBlock Text="Разъём на плате" Style="{StaticResource Cap}" Margin="0,16,0,4" />
                                <ComboBox x:Name="ArgbHeaderCombo" SelectionChanged="OnArgbChanged" />
                                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="«Все разъёмы» — сразу на все ARGB и RGB 12 В платы: номера в программе могут не совпадать с подписями на плате." />

                                <TextBlock Text="Способ" Style="{StaticResource Cap}" Margin="0,16,0,4" />
                                <ComboBox x:Name="ArgbMethodCombo" SelectionChanged="OnArgbChanged">
                                    <ComboBoxItem Content="Прямой — эффекты рисует программа" IsSelected="True" />
                                    <ComboBoxItem Content="Встроенный эффект платы (совместимость)" />
                                </ComboBox>
                                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Если в прямом способе вентиляторы не загораются — попробуйте встроенный: цвет, дыхание и радугу крутит сама плата, даже без программы. Волна, огонёк, температура и «как клавиатура» в нём упрощаются." />

                                <TextBlock x:Name="ArgbLedsLabel" Text="Светодиодов: 30" Margin="0,16,0,2" />
                                <Slider x:Name="ArgbLeds" Minimum="1" Maximum="120" Value="60" SmallChange="1"
                                        LargeChange="6" IsSnapToTickEnabled="True" TickFrequency="1" ValueChanged="OnArgbSlider" />
                                <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,0" TextWrapping="Wrap"
                                           Text="Сколько светодиодов на разъёме (все вентиляторы цепочкой вместе). Если волна или огонёк доходят не до конца — прибавьте; лишние ничему не мешают." />

                                <TextBlock x:Name="ArgbFansLabel" Text="Вентиляторов в цепочке: 3" Margin="0,16,0,2" />
                                <Slider x:Name="ArgbFans" Minimum="1" Maximum="6" Value="3" TickFrequency="1"
                                        IsSnapToTickEnabled="True" ValueChanged="OnArgbSlider" />

                                <TextBlock Style="{StaticResource Cap}" Margin="0,16,0,0" TextWrapping="Wrap"
                                           Text="Эффекты рисует программа, поэтому они работают, пока запущена Rig Control (можно в трее). После перезагрузки ПК плата сама вернёт свою подсветку до запуска программы." />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── Клавиатура ───────── -->
            <Grid x:Name="PageKeyboard" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Клавиатура AJAZZ AK820 Pro" Style="{StaticResource H1}" />
                        <TextBlock x:Name="StatusHint" Style="{StaticResource Cap}" Margin="0,4,0,0" />
                    </StackPanel>
                    <Button x:Name="ReconnectButton" Grid.Column="1" Content="Найти клавиатуру" VerticalAlignment="Top"
                            Click="OnReconnect" />
                </Grid>

                <Border Grid.Row="1" Background="{DynamicResource Surface2Brush}" CornerRadius="8" Padding="4"
                        HorizontalAlignment="Left" Margin="0,16,0,16">
                    <StackPanel Orientation="Horizontal">
                        <RadioButton x:Name="KbdTabScreen" Style="{StaticResource SegButton}" GroupName="KbdTab"
                                     Content="Экран и подсветка" IsChecked="True" Checked="OnKbdTabChecked" />
                        <RadioButton x:Name="KbdTabPaint" Style="{StaticResource SegButton}" GroupName="KbdTab"
                                     Content="Раскраска" Checked="OnKbdTabChecked" />
                    </StackPanel>
                </Border>

                <Grid Grid.Row="2">
                    <!-- Экран и подсветка клавиатуры -->
                    <ScrollViewer x:Name="KbdScreenPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="330" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <Border Grid.Column="0" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel>
                                    <TextBlock Text="Экран" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                        <Border Background="{DynamicResource PreviewBrush}" BorderBrush="{DynamicResource PressedBrush}" BorderThickness="3"
                                                CornerRadius="10" Padding="14" HorizontalAlignment="Center">
                                            <Image x:Name="PreviewImage" Width="244" Height="244"
                                                   RenderOptions.BitmapScalingMode="NearestNeighbor" Stretch="Uniform" />
                                        </Border>

                                        <TextBlock x:Name="FramesText" Style="{StaticResource Cap}" Margin="0,10,0,0"
                                                   Text="Картинка не выбрана" />

                                        <Button x:Name="PickButton" Content="Выбрать картинку или гифку…" Margin="0,12,0,0"
                                                Click="OnPickImage" />

                                        <TextBlock Text="Кадр" Style="{StaticResource Cap}" Margin="0,14,0,4" />
                                        <ComboBox x:Name="FitCombo" SelectionChanged="OnFitChanged">
                                            <ComboBoxItem Content="Обрезать по краям" IsSelected="True" />
                                            <ComboBoxItem Content="Вписать целиком" />
                                        </ComboBox>

                                        <TextBlock Text="Кадров в гифке" Style="{StaticResource Cap}" Margin="0,12,0,4" />
                                        <ComboBox x:Name="MaxFramesCombo" SelectionChanged="OnFitChanged">
                                            <ComboBoxItem Content="Все" Tag="0" />
                                            <ComboBoxItem Content="не больше 60" Tag="60" />
                                            <ComboBoxItem Content="не больше 40" Tag="40" IsSelected="True" />
                                            <ComboBoxItem Content="не больше 20" Tag="20" />
                                            <ComboBoxItem Content="не больше 10" Tag="10" />
                                        </ComboBox>

                                        <ProgressBar x:Name="UploadProgress" Margin="0,14,0,0" Minimum="0" Maximum="1"
                                                     Visibility="Collapsed" />

                                        <Button x:Name="CancelButton" Content="Отменить заливку" Margin="0,14,0,0"
                                                Click="OnCancelUpload" Visibility="Collapsed" />

                                        <Button x:Name="UploadButton" Style="{StaticResource AccentButton}" Content="Отправить на экран"
                                                Margin="0,14,0,0" Padding="14,11" Click="OnUpload" IsEnabled="False" />

                                        <Button x:Name="TimeButton" Content="Синхронизировать часы" Margin="0,8,0,0"
                                                Click="OnSyncTime" IsEnabled="False" />

                                    <TextBlock Style="{StaticResource Cap}" Margin="0,10,0,0" Text="PNG, JPG, GIF · 128×128 · заливка только по кабелю." />
                                </StackPanel>
                            </Border>

                            <Border Grid.Column="2" Style="{StaticResource Card}" VerticalAlignment="Top">
                                <StackPanel MaxWidth="460" HorizontalAlignment="Left">
                                    <TextBlock Text="Подсветка" Style="{StaticResource H2}" Margin="0,0,0,12" />
                                        <TextBlock Text="Эффект" Style="{StaticResource Cap}" Margin="0,0,0,4" />
                                        <ComboBox x:Name="EffectCombo" SelectionChanged="OnEffectChanged" />

                                        <CheckBox x:Name="RainbowCheck" Content="Радуга (цвет не используется)" Margin="0,16,0,0"
                                                  Click="OnRainbowChanged" />

                                        <CheckBox x:Name="SyncLightCheck" Content="Подсветка в такт гифке" Margin="0,10,0,0"
                                                  Click="OnSyncLightChanged" />
                                        <ComboBox x:Name="SyncStyleCombo" Margin="0,8,0,0" SelectionChanged="OnSyncStyleChanged">
                                            <ComboBoxItem Content="Картинка гифки на клавишах" />
                                            <ComboBoxItem Content="Волна от экрана" />
                                            <ComboBoxItem Content="Один цвет кадра" />
                                        </ComboBox>
                                        <TextBlock x:Name="SyncStyleHint" Style="{StaticResource Cap}" Margin="0,6,0,0" TextWrapping="Wrap" />

                                        <TextBlock Text="Цвет" Style="{StaticResource Cap}" Margin="0,16,0,8" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl x:Name="LightWheelHost" Grid.Column="0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <WrapPanel x:Name="LightSwatches" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border x:Name="ColorSwatch" Width="38" Height="34" CornerRadius="6"
                                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="White" />
                                                    <TextBox x:Name="ColorBox" Width="110" Margin="8,0,0,0" TextChanged="OnColorTextChanged" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>

                                        <TextBlock x:Name="BrightnessLabel" Text="Яркость: 5" Margin="0,18,0,2" />
                                        <Slider x:Name="BrightnessSlider" Minimum="0" Maximum="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="5" ValueChanged="OnBrightnessChanged" />

                                        <TextBlock x:Name="SpeedLabel" Text="Скорость: 3" Margin="0,12,0,2" />
                                        <Slider x:Name="SpeedSlider" Minimum="0" Maximum="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="3" ValueChanged="OnSpeedChanged" />

                                        <TextBlock Text="Направление" Style="{StaticResource Cap}" Margin="0,14,0,4" />
                                        <ComboBox x:Name="DirectionCombo" SelectionChanged="OnDirectionChanged">
                                            <ComboBoxItem Content="Вариант 1 (по умолчанию)" IsSelected="True" />
                                            <ComboBoxItem Content="Вариант 2" />
                                            <ComboBoxItem Content="Вариант 3" />
                                            <ComboBoxItem Content="Вариант 4" />
                                        </ComboBox>

                                        <StackPanel Orientation="Horizontal" Margin="0,22,0,0">
                                            <Button x:Name="ApplyButton" Style="{StaticResource AccentButton}" Content="Применить"
                                                    Padding="22,10" Click="OnApplyEffect" IsEnabled="False" />
                                            <Button x:Name="OffButton" Content="Выключить" Margin="10,0,0,0" Padding="18,10"
                                                    Click="OnLightOff" IsEnabled="False" />
                                            <Button x:Name="DemoButton" Content="Подобрать" Margin="10,0,0,0" Padding="18,10"
                                                    Click="OnEffectDemo" IsEnabled="False" />
                                        </StackPanel>
                                    <TextBlock Style="{StaticResource Cap}" Margin="0,12,0,0" Text="Свои эффекты (в конце списка) и картинка на клавишах — только по кабелю." />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </ScrollViewer>

                    <!-- Своя раскраска по клавишам -->
                    <ScrollViewer x:Name="KbdPaintPanel" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled"
                                  Visibility="Collapsed">
                        <StackPanel Margin="0,0,6,0">
                            <Border Style="{StaticResource Card}" Padding="14">
                                <StackPanel>
                                    <Viewbox Stretch="Uniform" StretchDirection="Both" MaxHeight="330">
                                        <Grid>
                                            <Border Width="644" Height="276" CornerRadius="10" Background="{DynamicResource KeyDeckBrush}"
                                                    BorderBrush="#535B68" BorderThickness="1" />
                                            <Canvas x:Name="PaintCanvas" Width="644" Height="276" Background="Transparent"
                                                    Cursor="Pen"
                                                    MouseLeftButtonDown="OnPaintDown" MouseRightButtonDown="OnPaintPick"
                                                    MouseMove="OnPaintMove" MouseLeftButtonUp="OnPaintUp"
                                                    LostMouseCapture="OnPaintLostCapture" />
                                        </Grid>
                                    </Viewbox>
                                    <!-- Схема в такт с клавиатурой: показывает подсветку, которая горит сейчас -->
                                    <CheckBox x:Name="PaintMirrorCheck" Margin="2,14,0,0" Click="OnPaintMirrorChanged">
                                        <StackPanel>
                                            <TextBlock Text="Подсветка в реальном времени" FontWeight="SemiBold" TextWrapping="Wrap" />
                                            <TextBlock Style="{StaticResource Cap}" Margin="0,3,0,0"
                                                       Text="На схеме — текущие цвета клавиатуры. Во время рисования показывается ваша раскраска." />
                                        </StackPanel>
                                    </CheckBox>
                                    <TextBlock x:Name="PaintMirrorHint" Style="{StaticResource Cap}" Margin="29,4,0,0"
                                               Visibility="Collapsed" />
                                </StackPanel>
                            </Border>

                            <Grid Margin="0,14,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <Border Grid.Column="0" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Кисть" Style="{StaticResource H2}" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,10"
                                                   Text="ЛКМ — красить · Shift — стереть · ПКМ — пипетка" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" />
                                                <ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <ContentControl x:Name="PaintWheelHost" Grid.Column="0" VerticalAlignment="Top" />
                                            <StackPanel Grid.Column="1" Margin="16,0,0,0">
                                                <WrapPanel x:Name="PaintSwatches" />
                                                <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                                    <Border x:Name="PaintColorSwatch" Width="38" Height="34" CornerRadius="6"
                                                            BorderBrush="{DynamicResource LineBrush}" BorderThickness="1" Background="#FF7EB6" />
                                                    <TextBox x:Name="PaintColorBox" Width="110" Margin="8,0,0,0" Text="#FF7EB6"
                                                             TextChanged="OnPaintColorTextChanged" />
                                                </StackPanel>
                                            </StackPanel>
                                        </Grid>
                                    </StackPanel>
                                </Border>

                                <Border Grid.Column="2" Style="{StaticResource Card}">
                                    <StackPanel>
                                        <TextBlock Text="Наборы" Style="{StaticResource H2}" />
                                        <WrapPanel x:Name="PaintPresets" Margin="0,10,0,0" />
                                        <StackPanel Orientation="Horizontal" Margin="0,6,0,0">
                                            <Button Content="Залить всё" Click="OnPaintFillAll" />
                                            <Button Content="Очистить" Margin="8,0,0,0" Click="OnPaintClear" />
                                        </StackPanel>

                                        <TextBlock Text="Анимация" Style="{StaticResource H2}" Margin="0,18,0,0" />
                                        <ComboBox x:Name="PaintAnimCombo" Margin="0,10,0,0" SelectionChanged="OnPaintAnimChanged" />
                                        <TextBlock x:Name="PaintSpeedLabel" Text="Скорость: 2" Margin="0,12,0,2" />
                                        <Slider x:Name="PaintSpeedSlider" Minimum="0" Maximum="5" TickFrequency="1"
                                                IsSnapToTickEnabled="True" Value="2" ValueChanged="OnPaintSpeedChanged" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,6,0,0" Text="Анимация — только по кабелю." />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                                <Button x:Name="PaintApplyButton" Style="{StaticResource AccentButton}" Content="Применить"
                                        Padding="22,11" Click="OnPaintApply" IsEnabled="False" />
                                <TextBlock x:Name="PaintCountText" Style="{StaticResource Cap}" VerticalAlignment="Center"
                                           Margin="14,0,0,0" TextWrapping="NoWrap" />
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>

                <TextBlock Grid.Row="3" x:Name="LogText" Style="{StaticResource Cap}" Margin="0,12,0,0" Text="Готово." />
            </Grid>

            <!-- ───────── О системе: характеристики ПК и андервольтинг ───────── -->
            <Grid x:Name="PageSystem" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="820" HorizontalAlignment="Left">
                        <TextBlock Text="О системе" Style="{StaticResource H1}" />
                        <TextBlock Style="{StaticResource Cap}" Margin="0,4,0,18"
                                   Text="Характеристики ПК и показатели андервольтинга процессора и видеокарты." />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Характеристики" Style="{StaticResource H2}" />
                                <TextBlock x:Name="SysSpecsNote" Style="{StaticResource Cap}" Margin="0,8,0,0" Text="Определяю…" />
                                <Grid x:Name="SysSpecsGrid" Margin="0,4,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="Андервольтинг" Style="{StaticResource H2}" VerticalAlignment="Center" />
                                    <Button Grid.Column="1" Content="Сбросить" Click="OnSysReset"
                                            ToolTip="Обнулить пики и средние под нагрузкой" />
                                </Grid>
                                <TextBlock Style="{StaticResource Cap}" Margin="0,8,0,14"
                                           Text="Запустите игру или тест на 10–15 минут и вернитесь сюда. Пики и средние под нагрузкой (от 90 %) копятся, пока открыта эта страница, а с записью в фоне — и когда окно свёрнуто или в трее." />
                                <CheckBox x:Name="SysRecordSwitch" Style="{StaticResource Switch}" Click="OnSysRecord">
                                    <StackPanel>
                                        <TextBlock Text="Запись в фоне" FontWeight="SemiBold" />
                                        <TextBlock x:Name="SysRecordText" Style="{StaticResource Cap}" Margin="0,2,0,0"
                                                   Text="Датчики опрашиваются раз в секунду, пока запись включена." />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="SysCpuSummary" Margin="0,16,0,0" TextWrapping="Wrap" LineHeight="20" />
                                <TextBlock x:Name="SysGpuSummary" Margin="0,10,0,0" TextWrapping="Wrap" LineHeight="20" />
                                <TextBlock x:Name="SysSensorsNote" Style="{StaticResource Cap}" Margin="0,10,0,0" Visibility="Collapsed"
                                           Foreground="{DynamicResource BadBrush}" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="SysCpuTitle" Text="Процессор" Style="{StaticResource H2}" />
                                <Grid Margin="0,12,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Margin="0,0,24,0">
                                        <TextBlock Text="Curve Optimizer" Style="{StaticResource Cap}" />
                                        <TextBlock x:Name="SysCoValue" Text="…" FontSize="26" FontWeight="SemiBold" />
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                                        <WrapPanel x:Name="SysCoCores" />
                                        <TextBlock x:Name="SysCoNote" Style="{StaticResource Cap}" Margin="0,4,0,0" />
                                    </StackPanel>
                                </Grid>
                                <Grid x:Name="SysCpuGrid" Margin="0,10,0,0" />
                                <TextBlock x:Name="SysVcoreNote" Style="{StaticResource Cap}" Margin="0,8,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock Text="Оперативная память" Style="{StaticResource H2}" />
                                <TextBlock x:Name="SysRamTitle" Text="…" FontSize="26" FontWeight="SemiBold" Margin="0,12,0,0" />
                                <TextBlock x:Name="SysRamNote" Style="{StaticResource Cap}" Margin="0,2,0,0" />
                                <UniformGrid x:Name="SysRamGrid" Columns="5" Margin="0,6,0,0" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <TextBlock x:Name="SysGpuTitle" Text="Видеокарта" Style="{StaticResource H2}" />
                                <Grid x:Name="SysGpuGrid" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>

                        <Border x:Name="SysTipsCard" Style="{StaticResource Card}" Visibility="Collapsed">
                            <StackPanel>
                                <TextBlock Text="Как андервольтить" Style="{StaticResource H2}" />
                                <TextBlock x:Name="SysTipsCpu" Style="{StaticResource Cap}" Margin="0,8,0,0" />
                                <TextBlock x:Name="SysTipsGpu" Style="{StaticResource Cap}" Margin="0,10,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>

            <!-- ───────── Настройки ───────── -->
            <Grid x:Name="PageSettings" Grid.Row="1" Margin="28,0,28,20" Visibility="Collapsed">
                <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                    <StackPanel MaxWidth="720" HorizontalAlignment="Left">
                        <TextBlock Text="Настройки" Style="{StaticResource H1}" Margin="0,0,0,18" />

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <StackPanel>
                                <CheckBox x:Name="SwitchAutostart" Style="{StaticResource Switch}" Click="OnSettingAutostart">
                                    <StackPanel>
                                        <TextBlock Text="Запускать вместе с Windows" FontWeight="SemiBold" />
                                        <TextBlock Style="{StaticResource Cap}" Margin="0,2,0,0" Text="Свёрнутой в трей." />
                                    </StackPanel>
                                </CheckBox>
                                <TextBlock x:Name="AutostartNote" Style="{StaticResource Cap}" Margin="58,6,0,0" Visibility="Collapsed" />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <CheckBox x:Name="SwitchTray" Style="{StaticResource Switch}" Click="OnSettingTray">
                                <StackPanel>
                                    <TextBlock Text="Сворачивать в трей при закрытии" FontWeight="SemiBold" />
                                    <TextBlock Style="{StaticResource Cap}" Margin="0,2,0,0" Text="Выход — из меню значка в трее." />
                                </StackPanel>
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource Card}" Margin="0,0,0,14">
                            <CheckBox x:Name="SwitchAutoOutput" Style="{StaticResource Switch}" Click="OnSettingAutoOutput">
                                <TextBlock Text="Автовывод на помпу при запуске" FontWeight="SemiBold" />
                            </CheckBox>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="О программе" Style="{StaticResource H2}" />
                                <TextBlock x:Name="AboutText" Style="{StaticResource Cap}" Margin="0,8,0,0" />
                            </StackPanel>
                        </Border>
                    </StackPanel>
                </ScrollViewer>
            </Grid>
        </Grid>
    </Grid>
</Window>
